# ===========================================
# TONIC LIFE 2.0 - Frontend Environment Variables
# ===========================================

# Backend API URL (NestJS - toniclife-api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Environment
NODE_ENV=development

# Stripe (Payments)
# Get publishable key at: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Coming Soon / Countdown Gate (optional — remove LAUNCH_DATE to disable)
# Bypass via /config_sistemas (sets cookie per browser)
# LAUNCH_DATE=2026-02-27T11:00:00-06:00
# NEXT_PUBLIC_LAUNCH_DATE=2026-02-27T11:00:00-06:00
